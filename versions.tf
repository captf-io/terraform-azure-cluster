# Runtime floor and provider pin. The floor is the language subset both
# Terraform and OpenTofu accept (CONVENTIONS.md section 4); the provider is
# pinned exactly and locked per runtime under locks/ (section 5).
terraform {
  required_version = ">= 1.5.0"

  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "5.7.0"
    }
  }
}
